<Page x:Class="Jtodo.Views.TypeManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jtodo.Views"
      xmlns:conv="clr-namespace:Jtodo.Commands"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      FontFamily="Segoe UI"
      Title="Type Management">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        
        <!-- Validation Error Template -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <DockPanel>
                <Border BorderBrush="Red" BorderThickness="2" CornerRadius="3">
                    <AdornedElementPlaceholder/>
                </Border>
            </DockPanel>
        </ControlTemplate>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="White" Height="80" Margin="0,0,0,20">
            <Grid.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="5" ShadowDepth="2"/>
            </Grid.Effect>
            
            <TextBlock Text="Type Settings"
                       FontSize="32"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#333"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40,0,40,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Data Grid -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="20"
                        Padding="20"
                        MaxWidth="900"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,0"
                        Grid.RowSpan="2">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0" 
                                Background="#E0E0E0" 
                                CornerRadius="10,10,0,0"
                                Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Type Name" FontWeight="Bold" Margin="10,5"/>
                                <TextBlock Grid.Column="1" Text="Color" FontWeight="Bold" Margin="10,5"/>
                                <TextBlock Grid.Column="2" Text="" FontWeight="Bold" Margin="10,5"/>
                            </Grid>
                        </Border>

                        <!-- Type Items -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TypeItems}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Type Name Column -->
                                            <Grid Grid.Column="0" Margin="10,0">
                                                <!-- Display Mode -->
                                                <TextBlock Text="{Binding Text}" 
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick" 
                                                                      Command="{Binding DataContext.StartEditTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                                
                                                <!-- Edit Mode -->
                                                <TextBox Text="{Binding EditingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         BorderThickness="1"
                                                         BorderBrush="#2196F3"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" 
                                                                    Command="{Binding DataContext.SaveTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        <KeyBinding Key="Escape" 
                                                                    Command="{Binding DataContext.CancelEditTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>

                                            <!-- Color Column -->
                                            <Grid Grid.Column="1" Margin="10,0">
                                                <!-- Display Mode - Color Preview -->
                                                <Border Background="{Binding ColorHex}"
                                                        CornerRadius="5"
                                                        Width="80"
                                                        Height="30"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick" 
                                                                      Command="{Binding DataContext.StartEditTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <TextBlock Text="{Binding ColorHex}" 
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <!-- Edit Mode - Color Input -->
                                                <TextBox Text="{Binding EditingColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         BorderThickness="1"
                                                         BorderBrush="#2196F3"
                                                         MaxLength="7"
                                                         Width="100"
                                                         HorizontalAlignment="Left"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" 
                                                                    Command="{Binding DataContext.SaveTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        <KeyBinding Key="Escape" 
                                                                    Command="{Binding DataContext.CancelEditTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.DeleteTypeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F44336"
                                                    BorderThickness="0"
                                                    Width="80"
                                                    Height="30"
                                                    Cursor="Hand"
                                                    ToolTip="Delete Type">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="5">
                                                            <TextBlock Text="Delete" 
                                                                       FontSize="16"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#D32F2F"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add New Type Button -->
                        <Button Grid.Row="2"
                                Content="+ Add New Type"
                                Command="{Binding AddNewTypeCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#666"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Margin="15,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
