<Window x:Class="Jtodo.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Jtodo.Views"
    xmlns:conv="clr-namespace:Jtodo.Commands"
    mc:Ignorable="d"
    Title="Jtodo - Task Management" Height="700" Width="1200"
    WindowStartupLocation="CenterScreen">
    
<Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
</Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="#2C3E50"
                Width="250"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo/Title -->
                <Border Grid.Row="0" Padding="20" Background="#34495E">
                    <TextBlock Text="Jtodo"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <!-- Home Button -->
                    <Button Command="{Binding NavigateHomeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="20,15"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#34495E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Home" 
                                       FontSize="16" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Type Settings Button -->
                    <Button Command="{Binding NavigateTypeSettingsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="20,15"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left"
                            Margin="0,5,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#34495E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Type Settings" 
                                       FontSize="16" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Upcoming Tasks Section -->
                <Border Grid.Row="2" 
                        Background="#34495E"
                        CornerRadius="10"
                        Margin="15"
                        Padding="15"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Upcoming Tasks"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tasks List -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2C3E50"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Task Title (Bold) -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding TaskTitle}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180"/>

                                                <!-- List Name (Smaller, lighter) -->
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,3,0,0">
                                                    <Run Text="in " FontSize="11" Foreground="#BDC3C7"/>
                                                    <Run Text="{Binding ListName}" FontSize="11" Foreground="#BDC3C7" FontStyle="Italic"/>
                                                </TextBlock>

                                                <!-- Due Date Badge -->
                                                <Border Grid.Row="2"
                                                        Background="{Binding UrgencyColor}"
                                                        CornerRadius="10"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding DueDateText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Frame -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <!-- Hamburger Menu Button (Overlay) -->
        <Button Grid.Column="1"
                Command="{Binding ToggleSidebarCommand}"
                Width="50"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,10,0,0"
                Background="#34495E"
                BorderThickness="0"
                Cursor="Hand"
                Opacity="0.9">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="25"
                            Width="50"
                            Height="50">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="3"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Rectangle Fill="White" Height="3" Width="24" Margin="0,3" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle Fill="White" Height="3" Width="24" Margin="0,3" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle Fill="White" Height="3" Width="24" Margin="0,3" RadiusX="1.5" RadiusY="1.5"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#2C3E50"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1A252F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>


